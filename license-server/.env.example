# Copie para license-server/.env e preencha. Nunca coloque este arquivo dentro do app/APK.

# Servidor
PORT=8787
# Endereço público com HTTPS (é o que vai no app e aparece na tela de ativação da TV)
PUBLIC_URL=https://licenca.seudominio.com.br
DATA_DIR=./data
# Token para a API de administração (/admin/api/...). Gere um valor longo e aleatório.
ADMIN_TOKEN=

# ---------- Quem confere os pagamentos ----------
# checkout (padrão: checkout próprio + Asaas), nuvemshop ou shopify
STORE_PROVIDER=checkout

# ---------- Checkout próprio ----------
BRAND_NAME=GATES! TV
# Planos: id:Nome:preço:dias:ciclo (ciclo: MONTHLY, QUARTERLY, SEMIANNUALLY, YEARLY)
PLANS=mensal:Mensal:29.90:30:MONTHLY,trimestral:Trimestral:79.90:90:QUARTERLY,anual:Anual:299.00:365:YEARLY
# Links para baixar os apps (aparecem no fim da compra)
DOWNLOAD_TV=
DOWNLOAD_TV_LITE=
DOWNLOAD_PHONE=
DOWNLOAD_PHONE_LITE=
DOWNLOAD_TABLET=
DOWNLOAD_WINDOWS=

# ---------- Asaas (PIX, boleto e cartão — sem mensalidade) ----------
# Painel do Asaas → Integrações → Chave de API
ASAAS_API_KEY=
# sandbox (testes) ou production
ASAAS_ENV=sandbox
# Token que você escolhe ao cadastrar o webhook (Integrações → Webhooks → PUBLIC_URL/webhooks/asaas)
ASAAS_WEBHOOK_TOKEN=
# UNDEFINED = o cliente escolhe PIX, boleto ou cartão
ASAAS_BILLING_TYPE=UNDEFINED

# ---------- Nuvemshop (alternativa) ----------
# App criado no Portal de Parceiros da Nuvemshop, instalado na sua loja.
# Escopos: read_customers, read_orders (e write_webhooks para "registrar-webhooks").
NS_STORE_ID=
NS_ACCESS_TOKEN=
# Segredo do app (client secret): confere a assinatura dos webhooks
NS_APP_SECRET=
# Obrigatório pela Nuvemshop: nome do app + e-mail de contato
NS_USER_AGENT=GATES! TV Licencas (contato@seudominio.com.br)
# Situações de pagamento que contam como pago
NS_PAID_STATUSES=paid,partially_refunded

# ---------- Shopify (alternativa) ----------
SHOPIFY_SHOP=sua-loja.myshopify.com
SHOPIFY_API_VERSION=2026-07
# Opção 1: token do Admin API (shpat_...) de um app personalizado com read_customers e read_orders
SHOPIFY_ADMIN_TOKEN=
# Opção 2: app criado no Dev Dashboard (o token é obtido e renovado sozinho)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Segredo dos webhooks (se vazio, usa o SHOPIFY_CLIENT_SECRET)
SHOPIFY_WEBHOOK_SECRET=

# ---------- Assinatura ----------
# Quais itens do pedido são a assinatura (use um ou os dois). IDs numéricos do produto:
SUBSCRIPTION_PRODUCT_IDS=
# ...ou prefixos de SKU, ex.: GATES
SUBSCRIPTION_SKU_PREFIXES=GATES
# Duração por SKU (prefixo:dias). Sem regra, usa DEFAULT_PERIOD_DAYS.
SUBSCRIPTION_PLANS=GATES-MENSAL:30,GATES-TRIMESTRAL:90,GATES-ANUAL:365
DEFAULT_PERIOD_DAYS=30
# Folga para a cobrança recorrente acontecer antes de considerar atrasado (horas)
PAYMENT_TOLERANCE_HOURS=36
# Dias de aviso depois do vencimento, antes de suspender
GRACE_DAYS=4
# Tags de cliente no Shopify que forçam o estado
TAG_ACTIVE=gates-liberado
TAG_BLOCKED=gates-bloqueado

# ---------- Licenças ----------
# Chave privada ECDSA P-256 (PEM). Se vazia, é criada em DATA_DIR/license-private.pem na 1ª execução.
LICENSE_PRIVATE_KEY=
TOKEN_DAYS=3
MAX_DEVICES=3
RESYNC_MINUTES=30

# Entregue ao app junto com a licença (não fica dentro do APK)
APP_TMDB_KEY=
APP_OMDB_KEY=
# Link da loja (botão "Renovar assinatura" no app)
STORE_URL=https://sua-loja.com.br/products/gates-tv
SUPPORT_URL=

# Outras origens liberadas para a API (o app já é liberado). Ex.: https://sua-loja.com.br
CORS_ORIGINS=
